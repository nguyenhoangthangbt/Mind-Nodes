# App
APP_NAME=LeadLocal
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://leadlocal:localdev@localhost:5432/leadlocal

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change-me-to-random-64-char-string-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
MAGIC_LINK_EXPIRE_MINUTES=15

# Google Places API (required for search)
GOOGLE_PLACES_API_KEY=

# Yelp (optional enrichment)
YELP_API_KEY=

# Foursquare (optional enrichment)
FOURSQUARE_API_KEY=

# Hunter.io (optional email enrichment)
HUNTER_API_KEY=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_AGENCY_MONTHLY_PRICE_ID=
STRIPE_AGENCY_ANNUAL_PRICE_ID=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=hello@leadlocal.io

# Sentry (optional)
SENTRY_DSN=
